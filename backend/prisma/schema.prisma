generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  GLOBAL_ADMIN
  GLOBAL_GATE
  ADMIN
  STAFF
  GATE
}

enum InviteStatus {
  PENDING
  ACTIVE
  USED
  EXPIRED
  REVOKED
  OFFLINE_PENDING
  AWAITING_APPROVAL
}

enum EntryMode {
  PEDESTRIAN
  MOTORCYCLE
  VEHICLE
}

enum VisitStatus {
  INVITED
  ARRIVED
  EXITED
  CANCELLED
  DENIED
}

enum WorkflowType {
  NONE
  HOST_ONLY
  MANAGER_THEN_HOST
  SECURITY_THEN_HOST
}

enum InviteCategory {
  PERSONAL
  OFFICIAL
}

enum ProfileEditStatus {
  PENDING
  APPROVED
  DECLINED
}

model Organisation {
  id              String          @id @default(uuid())
  name            String
  code            String          @unique
  // White-label
  logoUrl         String?
  primaryColor    String?         @default("#2563eb")
  secondaryColor  String?         @default("#1e40af")
  emailIconBg     String?         @default("#ffffff")
  customDomain    String?
  // Settings
  requireApproval Boolean         @default(false)
  defaultWorkflow WorkflowType    @default(NONE)
  photoRetentionDays Int          @default(90)
  maxGates        Int             @default(10)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  users           User[]
  invites         Invite[]
  locations       Location[]
  staffAttendances StaffAttendance[]
  blacklist       BlacklistEntry[]
  workflows       ApprovalWorkflow[]
}

model Location {
  id             String       @id @default(uuid())
  name           String
  code           String
  address        String?
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  isShared       Boolean      @default(false)
  gates          Gate[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, code])
}

model Gate {
  id         String   @id @default(uuid())
  name       String
  code       String
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  isActive   Boolean  @default(true)
  sequence   Int      @default(0)
  admissionsEnabled Boolean @default(true)
  particularsCheckEnabled Boolean @default(true)
  dailyAdmissionLimit Int?
  assignments GateOfficerAssignment[]
  visits     GateVisit[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([locationId, code])
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  fullName       String
  role           Role         @default(STAFF)
  portfolio      String?
  phone          String?
  avatarPath     String?
  permissions    String[]     @default([])
  isActive       Boolean      @default(true)
  mustChangePassword Boolean   @default(true)
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  invites        Invite[]     @relation("HostInvites")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  auditLogs      AuditLog[]
  pushDevices    PushDevice[]
  gateAssignments GateOfficerAssignment[]
  gateVisits      GateVisit[]
  createdParticulars GateParticular[]
  /// Permanent non-guessable token encoded in the staff attendance QR
  staffQrToken         String?   @unique
  staffPinHash         String?
  staffPinFailCount    Int       @default(0)
  staffPinLockedUntil  DateTime?
  /// Live camera snap used on the printable staff badge (not the profile avatar)
  staffBadgePhotoPath  String?
  staffAttendances     StaffAttendance[] @relation("StaffAttendanceSubject")
  scannedAttendances   StaffAttendance[] @relation("StaffAttendanceScanner")
}

model Invite {
  id             String       @id @default(uuid())
  token          String       @unique
  passphrase     String
  status         InviteStatus @default(PENDING)
  purpose        String
  category       InviteCategory @default(OFFICIAL)
  guestCount     Int          @default(1)
  guestNames     String[]
  expectedMode   EntryMode?
  expectedAt     DateTime?
  expiresAt      DateTime
  revivedAt      DateTime?
  hostId         String
  host           User         @relation("HostInvites", fields: [hostId], references: [id])
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  locationId     String?
  visitors       Visitor[]
  isOffline      Boolean      @default(false)
  approvedById   String?
  workflowState  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Visitor {
  id          String      @id @default(uuid())
  inviteId    String
  invite      Invite      @relation(fields: [inviteId], references: [id])
  fullName    String
  email       String?
  phone       String?
  address     String?
  photoPath   String?
  qrCodeData  String?
  status      VisitStatus @default(INVITED)
  entryMode   EntryMode?
  enteredAt   DateTime?
  exitedAt    DateTime?
  deniedAt    DateTime?
  deniedReason String?
  gateId      String?
  entryById   String?
  exitById    String?
  gateNotes   String?
  hostAvailabilityStatus String @default("PENDING")
  hostWaitUntil DateTime?
  hostRespondedAt DateTime?
  lastHostPromptAt DateTime?
  idNumber    String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  gateVisits  GateVisit[]
  rings       RingCall[]
}

model BlacklistEntry {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  isGlobal       Boolean      @default(false)
  fullName       String?
  idNumber       String?
  phone          String?
  reason         String
  photoPath      String?
  isActive       Boolean      @default(true)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ApprovalWorkflow {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  type           WorkflowType @default(HOST_ONLY)
  steps          Json
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  details   Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

/// In-app ring between a gate officer and a host about one visitor.
model RingCall {
  id         String    @id @default(uuid())
  visitorId  String
  visitor    Visitor   @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  fromUserId String
  toUserId   String
  direction  String
  status     String    @default("RINGING")
  gateId     String?
  createdAt  DateTime  @default(now())
  answeredAt DateTime?
  endedAt    DateTime?

  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([visitorId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  channel   String   @default("in_app")
  meta      Json?
  createdAt DateTime @default(now())
}

/// Firebase Cloud Messaging registration tokens (one row per browser/device).
model PushDevice {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("web")
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ProfileEditRequest {
  id             String            @id @default(uuid())
  userId         String
  organisationId String
  status         ProfileEditStatus @default(PENDING)
  before         Json
  after          Json
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}


/// Officer-to-checkpoint assignments. Global gate officers may be assigned across agencies.
model GateOfficerAssignment {
  id        String   @id @default(uuid())
  gateId    String
  userId    String
  createdAt DateTime @default(now())
  gate      Gate     @relation(fields: [gateId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([gateId, userId])
  @@index([userId])
}

/// Immutable checkpoint event; a later denial never overwrites an earlier pass.
model GateVisit {
  id          String   @id @default(uuid())
  visitorId   String
  gateId      String
  officerId   String
  decision    String
  particularsChecked Boolean @default(false)
  evidencePhotos String[] @default([])
  notes       String?
  occurredAt  DateTime @default(now())
  visitor     Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  gate        Gate     @relation(fields: [gateId], references: [id], onDelete: Restrict)
  officer     User     @relation(fields: [officerId], references: [id], onDelete: Restrict)
  particulars GateParticular[]
  @@index([visitorId, occurredAt])
  @@index([gateId, occurredAt])
}

model GateParticular {
  id          String   @id @default(uuid())
  gateVisitId String
  kind        String   // WITHHELD or ALLOWED
  description String
  quantity    Int      @default(1)
  imagePath   String?
  returnedAt  DateTime?
  returnedById String?
  createdById String
  createdAt   DateTime @default(now())
  gateVisit   GateVisit @relation(fields: [gateVisitId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@index([gateVisitId])
}

/// One attendance row per staff member per calendar day (APP_TIMEZONE / Africa/Lagos).
/// First scan of the day = arrival; later scans set/refresh exit time.
model StaffAttendance {
  id             String       @id @default(uuid())
  userId         String
  organisationId String
  day            DateTime     /// Calendar date at 00:00 in the attendance timezone (stored as DateTime)
  arrivedAt      DateTime
  exitedAt       DateTime?
  arrivalGateId  String?
  exitGateId     String?
  scannedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation("StaffAttendanceSubject", fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  scannedBy      User?        @relation("StaffAttendanceScanner", fields: [scannedById], references: [id], onDelete: SetNull)
  @@unique([userId, day])
  @@index([organisationId, day])
  @@index([day])
}

/// Tracks rows created (or attendance written) by the demo seed so `--reset` can
/// remove only demo data, including attendance on pre-existing officers.
model DemoSeedRecord {
  id        String   @id @default(uuid())
  model     String
  recordId  String
  createdAt DateTime @default(now())

  @@unique([model, recordId])
  @@index([model])
}
