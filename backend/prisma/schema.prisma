generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SUPER_ADMIN
  GLOBAL_ADMIN
  GLOBAL_GATE
  ADMIN
  STAFF
  GATE
}

enum InviteStatus {
  PENDING
  ACTIVE
  USED
  EXPIRED
  REVOKED
  OFFLINE_PENDING
  AWAITING_APPROVAL
}

enum EntryMode {
  PEDESTRIAN
  MOTORCYCLE
  VEHICLE
}

enum VisitStatus {
  INVITED
  ARRIVED
  EXITED
  CANCELLED
  DENIED
}

enum WorkflowType {
  NONE
  HOST_ONLY
  MANAGER_THEN_HOST
  SECURITY_THEN_HOST
}

enum FooterCreditMobileMode {
  FLOATING
  STATIC
}

enum InviteCategory {
  PERSONAL
  OFFICIAL
}

enum ProfileEditStatus {
  PENDING
  APPROVED
  DECLINED
}

model Organisation {
  id              String          @id @default(uuid())
  name            String
  code            String          @unique
  // White-label
  logoUrl         String?
  primaryColor      String?         @default("#2563eb")
  secondaryColor    String?         @default("#1e40af")
  // Text colour on primary/brand surfaces; null = auto (white or dark for contrast)
  primaryTextColor  String?
  emailIconBg       String?         @default("#ffffff")
  customDomain    String?
  // Settings
  requireApproval Boolean         @default(false)
  requireDispatchHostApproval Boolean @default(false)
  defaultWorkflow WorkflowType    @default(NONE)
  photoRetentionDays Int          @default(90)
  maxGates        Int             @default(10)
  /// Order of this agency on the public login grid (0 = first).
  loginOrder      Int             @default(0)
  /// When false the agency is hidden from the login page grid.
  loginVisible    Boolean         @default(true)
  /// Short label on login tiles (e.g. "Navy"). Falls back to name.
  shortName       String?
  /// Custom background for the public login tile. Null = Auto (glass / brand colour).
  loginTileColor  String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  users           User[]
  invites         Invite[]
  locations       Location[]
  staffAttendances StaffAttendance[]
  blacklist       BlacklistEntry[]
  workflows       ApprovalWorkflow[]
  contractors     Contractor[]
  contractorLinks ContractorOrganisation[]
  dispatchDestinations DispatchDestination[]
  customFieldDefs AgencyCustomField[]
}

model Location {
  id             String       @id @default(uuid())
  name           String
  code           String
  address        String?
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  isShared       Boolean      @default(false)
  gates          Gate[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, code])
}

model Gate {
  id         String   @id @default(uuid())
  name       String
  code       String
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  isActive   Boolean  @default(true)
  sequence   Int      @default(0)
  admissionsEnabled Boolean @default(true)
  particularsCheckEnabled Boolean @default(true)
  dailyAdmissionLimit Int?
  assignments GateOfficerAssignment[]
  visits     GateVisit[]
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([locationId, code])
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  fullName       String
  role           Role         @default(STAFF)
  portfolio      String?
  phone          String?
  avatarPath     String?
  permissions    String[]     @default([])
  isActive       Boolean      @default(true)
  mustChangePassword Boolean   @default(true)
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  invites        Invite[]     @relation("HostInvites")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  auditLogs      AuditLog[]
  pushDevices    PushDevice[]
  gateAssignments GateOfficerAssignment[]
  gateVisits      GateVisit[]
  createdParticulars GateParticular[]
  /// Permanent non-guessable token encoded in the staff attendance QR
  staffQrToken         String?   @unique
  staffPinHash         String?
  staffPinFailCount    Int       @default(0)
  staffPinLockedUntil  DateTime?
  /// Live camera snap used on the printable staff badge (not the profile avatar)
  staffBadgePhotoPath  String?
  staffAttendances     StaffAttendance[] @relation("StaffAttendanceSubject")
  scannedAttendances   StaffAttendance[] @relation("StaffAttendanceScanner")
  /// Values for the agency's custom user fields, keyed by AgencyCustomField.key
  customFields         Json?
}

model Invite {
  id             String       @id @default(uuid())
  token          String       @unique
  passphrase     String
  status         InviteStatus @default(PENDING)
  purpose        String
  category       InviteCategory @default(OFFICIAL)
  guestCount     Int          @default(1)
  guestNames     String[]
  expectedMode   EntryMode?
  expectedAt     DateTime?
  expiresAt      DateTime
  revivedAt      DateTime?
  hostId         String
  host           User         @relation("HostInvites", fields: [hostId], references: [id])
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  locationId     String?
  visitors       Visitor[]
  isOffline      Boolean      @default(false)
  approvedById   String?
  workflowState  String?
  /// Expected vehicle / motorcycle (only when expectedMode is VEHICLE or MOTORCYCLE)
  vehiclePlate   String?
  vehicleDetails String?
  /// Host (or admin) cancelled the invite. Status becomes REVOKED; the gate shows "Cancelled".
  cancelledAt    DateTime?
  cancelledById  String?
  cancelReason   String?
  postponedAt    DateTime?
  postponeCount  Int          @default(0)
  /// Idempotent reminder flags (scheduler). Reset when the invite is postponed.
  reminderDaySentAt  DateTime?
  reminderHourSentAt DateTime?
  hostConfirmedAt    DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([expectedAt])
}

model Visitor {
  id          String      @id @default(uuid())
  inviteId    String
  invite      Invite      @relation(fields: [inviteId], references: [id])
  fullName    String
  email       String?
  phone       String?
  address     String?
  photoPath   String?
  qrCodeData  String?
  status      VisitStatus @default(INVITED)
  entryMode   EntryMode?
  enteredAt   DateTime?
  exitedAt    DateTime?
  deniedAt    DateTime?
  deniedReason String?
  gateId      String?
  entryById   String?
  exitById    String?
  gateNotes   String?
  hostAvailabilityStatus String @default("PENDING")
  hostWaitUntil DateTime?
  hostRespondedAt DateTime?
  lastHostPromptAt DateTime?
  idNumber    String?
  /// Shared same-day pass so one QR covers every invite for this person
  passToken   String?
  /// Vehicle actually used at the gate
  vehiclePlate   String?
  vehicleDetails String?
  /// No-contact guests (no email, no phone): photo taken by the gate officer, confirmed by the host
  gatePhotoPath        String?
  /// null | CAPTURED | PENDING | CONFIRMED | DECLINED
  identityStatus       String?
  identityRequestedAt  DateTime?
  identityRequestedById String?
  identityReviewedAt   DateTime?
  identityReviewedById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  gateVisits  GateVisit[]
  rings       RingCall[]
  transfers   VisitTransfer[]

  @@index([passToken])
}

model BlacklistEntry {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  isGlobal       Boolean      @default(false)
  fullName       String?
  idNumber       String?
  phone          String?
  reason         String
  photoPath      String?
  isActive       Boolean      @default(true)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ApprovalWorkflow {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  type           WorkflowType @default(HOST_ONLY)
  steps          Json
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  details   Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())
}

/// In-app ring between a gate officer (or any initiator) and a host about one visitor or dispatch.
model RingCall {
  id                String    @id @default(uuid())
  visitorId         String?
  visitor           Visitor?  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  dispatchId        String?
  fromUserId        String
  toUserId          String
  /// Logged-in account that placed this call (SA / SA II / super gate included).
  callerUserId      String?
  /// Intended answerer for this call (usually the host, or the initiator on a call-back).
  calleeUserId      String?
  /// Gate officer responsible: the initiator if they are a gate officer, else the officer on that gate.
  gateOfficerUserId String?
  parentCallId      String?
  parentCall        RingCall?  @relation("RingCallback", fields: [parentCallId], references: [id], onDelete: SetNull)
  callbacks         RingCall[] @relation("RingCallback")
  direction         String
  status            String    @default("RINGING")
  gateId            String?
  createdAt         DateTime  @default(now())
  answeredAt        DateTime?
  endedAt           DateTime?

  @@index([toUserId, status])
  @@index([fromUserId, status])
  @@index([visitorId, createdAt])
  @@index([dispatchId])
  @@index([parentCallId])
  @@index([callerUserId, createdAt])
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  channel   String   @default("in_app")
  meta      Json?
  createdAt DateTime @default(now())
}

/// Firebase Cloud Messaging registration tokens (one row per browser/device).
model PushDevice {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String   @unique
  platform  String   @default("web")
  userAgent String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model ProfileEditRequest {
  id             String            @id @default(uuid())
  userId         String
  organisationId String
  status         ProfileEditStatus @default(PENDING)
  before         Json
  after          Json
  reviewedById   String?
  reviewedAt     DateTime?
  reviewNote     String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
}


/// Officer-to-checkpoint assignments. Global gate officers may be assigned across agencies.
model GateOfficerAssignment {
  id        String   @id @default(uuid())
  gateId    String
  userId    String
  createdAt DateTime @default(now())
  gate      Gate     @relation(fields: [gateId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([gateId, userId])
  @@index([userId])
}

/// Immutable checkpoint event; a later denial never overwrites an earlier pass.
model GateVisit {
  id          String   @id @default(uuid())
  visitorId   String
  gateId      String
  officerId   String
  decision    String
  particularsChecked Boolean @default(false)
  evidencePhotos String[] @default([])
  notes       String?
  /// ENTRY (default) or EXIT — exit must also pass every checkpoint
  direction   String   @default("ENTRY")
  occurredAt  DateTime @default(now())
  visitor     Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  gate        Gate     @relation(fields: [gateId], references: [id], onDelete: Restrict)
  officer     User     @relation(fields: [officerId], references: [id], onDelete: Restrict)
  particulars GateParticular[]
  @@index([visitorId, occurredAt])
  @@index([gateId, occurredAt])
}

model GateParticular {
  id          String   @id @default(uuid())
  gateVisitId String
  kind        String   // WITHHELD or ALLOWED
  description String
  quantity    Int      @default(1)
  imagePath   String?
  returnedAt  DateTime?
  returnedById String?
  /// RETURNED | SEIZED | OTHER — required before the guest can exit
  resolution     String?
  resolutionNote String?
  resolvedAt     DateTime?
  resolvedById   String?
  createdById String
  createdAt   DateTime @default(now())
  gateVisit   GateVisit @relation(fields: [gateVisitId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Restrict)
  @@index([gateVisitId])
}

/// One attendance row per staff member per calendar day (APP_TIMEZONE / Africa/Lagos).
/// First scan of the day = arrival; later scans set/refresh exit time.
model StaffAttendance {
  id             String       @id @default(uuid())
  userId         String
  organisationId String
  day            DateTime     /// Calendar date at 00:00 in the attendance timezone (stored as DateTime)
  arrivedAt      DateTime
  exitedAt       DateTime?
  arrivalGateId  String?
  exitGateId     String?
  scannedById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  user           User         @relation("StaffAttendanceSubject", fields: [userId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  scannedBy      User?        @relation("StaffAttendanceScanner", fields: [scannedById], references: [id], onDelete: SetNull)
  @@unique([userId, day])
  @@index([organisationId, day])
  @@index([day])
}

/// Tracks rows created (or attendance written) by the demo seed so `--reset` can
/// remove only demo data, including attendance on pre-existing officers.
model DemoSeedRecord {
  id        String   @id @default(uuid())
  model     String
  recordId  String
  createdAt DateTime @default(now())

  @@unique([model, recordId])
  @@index([model])
}

/// Singleton platform-level sign-in, footer, and contractor policy. Edited by Super Admin only.
model PlatformSettings {
  id                        String   @id @default("platform")
  loginLogoUrl              String?
  loginLogoWidth            String?  @default("180px")
  loginWatermarkUrl         String?
  loginWatermarkWidth       String?  @default("70vw")
  loginWatermarkHeight      String?  @default("70vh")
  loginWatermarkOpacity     Float    @default(0.08)
  loginHeadline             String?
  loginPrimaryColor         String?
  loginSecondaryColor       String?
  footerCredit              String   @default("Powered by CISTECH's Vicit 1.0.1")
  footerCreditEnabled       Boolean  @default(true)
  /// Mobile footer: FLOATING sits above the bottom nav; STATIC is in document flow above nav padding.
  footerCreditMobileMode    FooterCreditMobileMode @default(FLOATING)
  /// Large title on the split login page. Default Defence Headquarters.
  loginTitle                String?  @default("Defence Headquarters")
  /// When false, an uploaded login logo is kept but not shown above the sign-in form.
  loginLogoVisible          Boolean  @default(true)
  contractorMinDurationDays Int      @default(1)
  /// Modes of entry accepted on invites and at the gate (PEDESTRIAN, MOTORCYCLE, VEHICLE)
  allowedEntryModes         String[] @default(["PEDESTRIAN", "MOTORCYCLE", "VEHICLE"])
  assetVersion              String   @default("1.0.1")
  createdAt                 DateTime @default(now())
  updatedAt                 DateTime @updatedAt
}

/// Temporary contractor / vendor pass. No login. Long-tail URL is staff-only.
model Contractor {
  id             String       @id @default(uuid())
  token          String       @unique
  qrToken        String       @unique
  fullName       String
  company        String?
  phone          String?
  email          String?
  photoPath      String?
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  validFrom      DateTime
  validThrough   DateTime
  /// daily | weekly | monthly | quarterly | yearly — used by Auto renew
  cycle          String       @default("monthly")
  terminatedAt   DateTime?
  terminatedReason String?
  terminatedById String?
  createdById    String
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  visits         ContractorVisit[]
  agencies       ContractorOrganisation[]

  @@index([organisationId, validThrough])
  @@index([email])
  @@index([phone])
}

model ContractorVisit {
  id             String     @id @default(uuid())
  contractorId   String
  contractor     Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  organisationId String
  destination    String?
  hostId         String?
  gateId         String?
  officerId      String?
  arrivedAt      DateTime   @default(now())
  exitedAt       DateTime?
  day            DateTime
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([contractorId, day])
  @@index([organisationId, day])
}

/// Many-to-many: a contractor pass can be attached to more than one agency.
model ContractorOrganisation {
  id             String       @id @default(uuid())
  contractorId   String
  organisationId String
  createdAt      DateTime     @default(now())
  contractor     Contractor   @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)

  @@unique([contractorId, organisationId])
  @@index([organisationId])
}

model Dispatch {
  id              String   @id @default(uuid())
  courierName     String
  courierPhone    String?
  courierCompany  String?
  photoPath       String?
  /// Additional particulars photos (photoPath remains the first/cover).
  photoPaths      String[]  @default([])
  notes           String?
  status          String   @default("REGISTERED")
  createdById     String
  gateId          String?
  requireApproval Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  destinations    DispatchDestination[]
  items           DispatchItem[]

  @@index([createdAt])
  @@index([status])
}

model DispatchItem {
  id          String   @id @default(uuid())
  dispatchId  String
  dispatch    Dispatch @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  description String
  quantity    Int      @default(1)
}

model DispatchDestination {
  id             String       @id @default(uuid())
  dispatchId     String
  dispatch       Dispatch     @relation(fields: [dispatchId], references: [id], onDelete: Cascade)
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  hostId         String?
  status         String       @default("PENDING")
  decidedAt      DateTime?
  decidedById    String?
  note           String?
  acknowledgedAt        DateTime?
  acknowledgedById      String?
  acknowledgeComment    String?

  @@unique([dispatchId, organisationId])
  @@index([organisationId, status])
}

model VisitTransfer {
  id                 String   @id @default(uuid())
  visitorId          String
  visitor            Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  fromOrganisationId String
  toOrganisationId   String
  fromHostId         String
  toHostId           String?
  comment            String
  createdAt          DateTime @default(now())

  @@index([visitorId, createdAt])
  @@index([toOrganisationId, createdAt])
}

/// Super Admin defined extra fields for user accounts, unique per agency (e.g. Rank on Army vs Air Force).
model AgencyCustomField {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id], onDelete: Cascade)
  key            String
  label          String
  /// text | textarea | radio | checkbox | date | dropdown
  type           String       @default("text")
  options        String[]     @default([])
  required       Boolean      @default(false)
  sortOrder      Int          @default(0)
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, key])
  @@index([organisationId, isActive])
}
