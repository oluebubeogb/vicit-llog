generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
  GATE
}

enum InviteStatus {
  PENDING
  ACTIVE
  USED
  EXPIRED
  REVOKED
  OFFLINE_PENDING
  AWAITING_APPROVAL
}

enum EntryMode {
  PEDESTRIAN
  MOTORCYCLE
  VEHICLE
}

enum VisitStatus {
  INVITED
  ARRIVED
  EXITED
  CANCELLED
  DENIED
}

enum WorkflowType {
  NONE
  HOST_ONLY
  MANAGER_THEN_HOST
  SECURITY_THEN_HOST
}

model Organisation {
  id              String          @id @default(uuid())
  name            String
  code            String          @unique
  // White-label
  logoUrl         String?
  primaryColor    String?         @default("#2563eb")
  secondaryColor  String?         @default("#1e40af")
  customDomain    String?
  // Settings
  requireApproval Boolean         @default(false)
  defaultWorkflow WorkflowType    @default(NONE)
  photoRetentionDays Int          @default(90)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  users           User[]
  invites         Invite[]
  locations       Location[]
  blacklist       BlacklistEntry[]
  workflows       ApprovalWorkflow[]
}

model Location {
  id             String       @id @default(uuid())
  name           String
  code           String
  address        String?
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  gates          Gate[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organisationId, code])
}

model Gate {
  id         String   @id @default(uuid())
  name       String
  code       String
  locationId String
  location   Location @relation(fields: [locationId], references: [id])
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([locationId, code])
}

model User {
  id             String       @id @default(uuid())
  email          String       @unique
  passwordHash   String
  fullName       String
  role           Role         @default(STAFF)
  portfolio      String?
  permissions    String[]     @default([])
  isActive       Boolean      @default(true)
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  invites        Invite[]     @relation("HostInvites")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  auditLogs      AuditLog[]
}

model Invite {
  id             String       @id @default(uuid())
  token          String       @unique
  passphrase     String
  status         InviteStatus @default(PENDING)
  purpose        String
  guestCount     Int          @default(1)
  guestNames     String[]
  expectedMode   EntryMode?
  expiresAt      DateTime
  revivedAt      DateTime?
  hostId         String
  host           User         @relation("HostInvites", fields: [hostId], references: [id])
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  locationId     String?
  visitors       Visitor[]
  isOffline      Boolean      @default(false)
  approvedById   String?
  workflowState  String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model Visitor {
  id          String      @id @default(uuid())
  inviteId    String
  invite      Invite      @relation(fields: [inviteId], references: [id])
  fullName    String
  photoPath   String?
  qrCodeData  String?
  status      VisitStatus @default(INVITED)
  entryMode   EntryMode?
  enteredAt   DateTime?
  exitedAt    DateTime?
  gateId      String?
  gateNotes   String?
  idNumber    String?
  phone       String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
}

model BlacklistEntry {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  fullName       String?
  idNumber       String?
  phone          String?
  reason         String
  photoPath      String?
  isActive       Boolean      @default(true)
  createdById    String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model ApprovalWorkflow {
  id             String       @id @default(uuid())
  organisationId String
  organisation   Organisation @relation(fields: [organisationId], references: [id])
  name           String
  type           WorkflowType @default(HOST_ONLY)
  steps          Json
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String?
  details   Json?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  ip        String?
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  isRead    Boolean  @default(false)
  channel   String   @default("in_app")
  meta      Json?
  createdAt DateTime @default(now())
}
