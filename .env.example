# ======================
# Vicit Llog – Phase 1 + 2
# ======================

# PostgreSQL
POSTGRES_USER=vicit
POSTGRES_PASSWORD=vicit_secret_change_me
POSTGRES_DB=vicit_llog
DATABASE_URL=postgresql://vicit:vicit_secret_change_me@db:5432/vicit_llog?schema=public

# Backend
JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
PHOTO_STORAGE_PATH=/data/photos
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
PORT=4000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Vicit Llog

INVITE_LINK_TTL_MINUTES=60
PHOTO_RETENTION_DAYS=90

# ========== SMS ==========
# Options: log | twilio | termii | africastalking
SMS_PROVIDER=log
# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
# Termii (Nigeria)
TERMII_API_KEY=
TERMII_SMS_FROM=VicitLlog
# Africa's Talking
AT_USERNAME=
AT_API_KEY=
AT_SMS_FROM=

# ========== WhatsApp ==========
# Options: log | twilio | meta
WHATSAPP_PROVIDER=log
# Twilio WhatsApp (e.g. whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=
# Meta Cloud API
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=
