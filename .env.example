# ======================
# Vicit Llog
# ======================

POSTGRES_USER=vicit
POSTGRES_PASSWORD=vicit_secret_change_me
POSTGRES_DB=vicit_llog
DATABASE_URL=postgresql://vicit:vicit_secret_change_me@db:5432/vicit_llog?schema=public

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
PHOTO_STORAGE_PATH=/data/photos
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
PORT=4000

NEXT_PUBLIC_API_URL=http://localhost:4000
# Public HTTPS URL of the API as seen from visitors' phones (used for the hosted QR image
# link in visitor emails). Falls back to NEXT_PUBLIC_API_URL; localhost URLs are skipped.
API_PUBLIC_URL=
NEXT_PUBLIC_APP_NAME=Vicit Llog
# Server-side URL the Next.js server uses to reach the API (dynamic PWA manifest reads
# Branding & Settings through it). In docker-compose this is http://backend:4000.
# Falls back to NEXT_PUBLIC_API_URL.
API_INTERNAL_URL=

# REQUIRED — only source of the deployment Super Admin login (no hardcoded defaults)
ADMIN_EMAIL=admin@yourorg.com
ADMIN_PASSWORD=ChangeMeNow!
ADMIN_NAME=System Administrator
ADMIN_PHONE=
ORGANIZATION=Your Organisation Name
ORGANIZATION_CODE=YOURORG

INVITE_LINK_TTL_MINUTES=60
PHOTO_RETENTION_DAYS=90

# ---- Web Push (VAPID) ----
# In-app alerts and gate/host rings are also delivered as Web Push to browsers and installed PWAs.
# Generate a stable pair with: npx web-push generate-vapid-keys
# Leave the keys empty only for local experiments — the API will use ephemeral keys that die on restart.
# Set ENABLE_PUSH=false to turn delivery off. Anything else (including empty) leaves it on.
ENABLE_PUSH=true
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:support@yourorg.com

SMS_PROVIDER=log
WHATSAPP_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TERMII_API_KEY=
TERMII_SMS_FROM=VicitLlog
AT_USERNAME=
AT_API_KEY=
AT_SMS_FROM=
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=


# Show temporary passwords in Admin UI (create / reset / bulk CSV). Default off.
# Emails are always sent when SMTP is configured, regardless of this flag.
SHOW_TEMP_PASSWORDS_IN_ADMIN=false

# SMTP (welcome + password-reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vicit Llog <noreply@yourorg.com>"

# Email header logo background (for transparent PNG icons)
EMAIL_ICON_BG=#ffffff
EMAIL_LOGO_URL=
EMAIL_BRAND_COLOR=#1e40af

# ---- WebRTC TURN (optional, for ring voice on strict networks) ----
# Public STUN (stun:stun.l.google.com:19302) is always used. Set these if calls
# fail behind symmetric NAT or strict firewalls. See README "Voice calls: TURN server".
# TURN_URL may be a single URI or a comma-separated list (UDP, TCP, and TURNS):
#   turn:turn.example.com:3478?transport=udp,turn:turn.example.com:3478?transport=tcp,turns:turn.example.com:5349?transport=tcp
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# App timezone used for attendance calendar days and contractor validity.
APP_TIMEZONE=Africa/Lagos
