POSTGRES_USER=vicit
POSTGRES_PASSWORD=vicit_secret_change_me
POSTGRES_DB=vicit_llog
DATABASE_URL=postgresql://vicit:vicit_secret_change_me@db:5432/vicit_llog?schema=public

JWT_SECRET=change-this-to-a-long-random-string-in-production
JWT_EXPIRES_IN=7d
PHOTO_STORAGE_PATH=/data/photos
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
PORT=4000

NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_APP_NAME=Vicit Llog

# REQUIRED — only source of admin login (no hardcoded defaults)
ADMIN_EMAIL=admin@yourorg.com
ADMIN_PASSWORD=ChangeMeNow!
ADMIN_NAME=System Administrator
ADMIN_PHONE=
ORGANIZATION=Your Organisation Name
ORGANIZATION_CODE=YOURORG

INVITE_LINK_TTL_MINUTES=60
PHOTO_RETENTION_DAYS=90

SMS_PROVIDER=log
WHATSAPP_PROVIDER=log
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
TERMII_API_KEY=
TERMII_SMS_FROM=VicitLlog
AT_USERNAME=
AT_API_KEY=
AT_SMS_FROM=
META_WA_TOKEN=
META_WA_PHONE_NUMBER_ID=


# Show temporary passwords in Admin UI (create / reset / bulk CSV). Default off.
# Emails are always sent when SMTP is configured, regardless of this flag.
SHOW_TEMP_PASSWORDS_IN_ADMIN=false

# SMTP (welcome + password-reset emails)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Vicit Llog <noreply@yourorg.com>"

# Email header logo background (for transparent PNG icons)
EMAIL_ICON_BG=#ffffff
EMAIL_LOGO_URL=
EMAIL_BRAND_COLOR=#1e40af
